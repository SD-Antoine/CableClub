# anchored to the project root: a bare "data*/" also matched web/js/data/
# and left the interface out of the GitHub releases (0.4.1 and 0.4.2)
/build/
/dist/
/data/
/data*/
/serveur/
# security audit (point 9): reports stay local until a flaw is fixed; scan runs never enter the repo
/docs/security/
/tests/security/strix_runs/
# game files, saves, firmwares, ROM patches and emulator states: never in the repository (point 6; the same list
# as tests/assets-check.mjs, which also fails the CI on them)
*.gb
*.gbc
*.cgb
*.sgb
*.gba
*.agb
*.nds
*.dsi
*.srl
*.3ds
*.cia
